NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=

# Public origin for canonical URLs, Open Graph, the sitemap, and robots.
# No trailing slash. When unset, the app uses https://digital-legacy-five.vercel.app.
# Set this in Vercel to the production origin, including on Preview if previews
# should keep that canonical origin. Do not point it at a preview deployment URL.
# A custom domain is separate; update this value when the public origin changes.
NEXT_PUBLIC_SITE_URL=https://digital-legacy-five.vercel.app
