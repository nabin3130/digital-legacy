# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# anon public key, or the newer publishable key (sb_publishable_...).
# Do not put a service role or secret key in this variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional inbox for contact-form email delivery. Blank uses the address on the privacy policy.
NEXT_PUBLIC_CONTACT_EMAIL=
